<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_custom_currency" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.custom.currency</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Remove the original hidden currency_id -->
            <xpath expr="//page[@name='payroll_information']/field[@name='currency_id']" position="replace">
            </xpath>
            <!-- Insert editable currency selector inside Contract Overview, before Contract dates -->
            <xpath expr="//page[@name='payroll_information']//group[@name='contract']//label[@for='contract_date_start']" position="before">
                <field name="currency_id" string="Contract Currency"
                       options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
