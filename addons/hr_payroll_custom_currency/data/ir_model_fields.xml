<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Create x_contract_currency_id field on hr.version (contract model) -->
    <record id="field_hr_version_x_contract_currency_id" model="ir.model.fields">
        <field name="name">x_contract_currency_id</field>
        <field name="field_description">Contract Currency</field>
        <field name="model_id" ref="hr.model_hr_version"/>
        <field name="ttype">many2one</field>
        <field name="relation">res.currency</field>
        <field name="required" eval="True"/>
        <field name="store" eval="True"/>
        <field name="readonly" eval="False"/>
        <field name="copied" eval="True"/>
        <field name="on_delete">restrict</field>
    </record>

</odoo>
